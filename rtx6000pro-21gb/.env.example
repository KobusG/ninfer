# Vast.ai API key - https://cloud.vast.ai/account/
VAST_API_KEY=

# Bearer token required by the served API. Invent one; it is not issued by anybody.
NINFER_API_KEY=

# Written automatically by 'ninfer create' / 'ninfer up'. Leave blank.
NINFER_BASE_URL=

# Rental and model selection. qwen38-nvfp4 selects the larger Blackwell W4A4/FP8 profile.
NINFER_MODEL=qwen38-27b
NINFER_GPU_NAME="RTX PRO 4000"
NINFER_SECURE_CLOUD=1
NINFER_OFFER_RANK=2
NINFER_DISK=80

# Measured 21 GiB coexistence profile. Keep this for the 24 GB production host.
# The current image also passed a 524288-token pool on RTX PRO 5000, including
# exact retrieval from a 369313-token prompt at 28182 MiB peak. That is a
# hardware-max test profile, not the 21 GiB production profile below.
NINFER_KV_DTYPE=rk4v4-e8
NINFER_MAX_CONTEXT=145920
NINFER_KV_CAPACITY=145920
NINFER_MAX_CONCURRENCY=2
# RTX PRO 4000 needs 512 for long prefills; 1024 exceeded its cooperative-launch capacity.
NINFER_PREFILL_CHUNK=512
NINFER_SPEC=mtp
NINFER_DRAFT_TOKENS=3
NINFER_VISION=1
NINFER_VISION_MAX_TOKENS=8192
