#!/usr/bin/env bash
# ninfer — Qwen3.8-27B workflow capped at 21 GiB for RTX Pro Blackwell hosts.
#
#   ninfer create   rent a fresh test GPU and provision it from scratch
#   ninfer provision finish a box that create left half-built
#   ninfer destroy  delete the instance entirely — idle cost goes to $0.00
#   ninfer up       resume a STOPPED instance (~2 min, only if one exists)
#   ninfer down     stop an instance (keeps the disk, still bills for it)
#   ninfer status   state, endpoint, hourly cost, health
#   ninfer offers   list compatible low-VRAM GPUs worth renting right now
#   ninfer ssh      shell on the box
#   ninfer log      tail the server log
#   ninfer bench    measure decode throughput across concurrency levels
#   ninfer kit-url  download URL for the prebuilt binaries
#   ninfer restore  reinstall those binaries on the current box
#
# Nothing about the address is stable: Vast reassigns the public IP, the mapped
# port and the ssh port on every start, so all three are resolved per call.
set -euo pipefail

# Resolve this script's real directory, following symlinks, so a clone works
# from anywhere and an installed symlink still finds its own .env.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd)
  _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
SELF_DIR=$(cd -P "$(dirname "$_src")" && pwd)
SELF="$SELF_DIR/${_src##*/}"   # absolute — usage is printed after cd "$PROJ"

PROJ="${NINFER_PROJ:-$SELF_DIR}"
cd "$PROJ"
ENV_FILE="${NINFER_ENV_FILE:-$PROJ/.env}"
set -a; . "$ENV_FILE"; set +a
: "${VAST_API_KEY:?missing VAST_API_KEY in $ENV_FILE}"
: "${NINFER_API_KEY:?missing NINFER_API_KEY in $ENV_FILE}"

STATE="$PROJ/.ninfer-instance"
BADHOSTS="$PROJ/.ninfer-badhosts"   # machines that failed to start; skipped by pick_offer
SSH_KEY="${NINFER_SSH_KEY:-$HOME/.ssh/kobus}"
CONFIGS=(
  "$HOME/.config/opencode/opencode.json"
  "$HOME/.config-opencode-ninfer/opencode/opencode.json"
)
# Which provider key in those configs this card owns. Separate from the 3090's
# "ninfer" entry on purpose: the two serve different artifacts under different
# model ids, and only one is ever live.
PROVIDER="${NINFER_PROVIDER:-ninfer6000pro21gb}"

# The default rental target has 24GB-class VRAM like the target VPS.
IMAGE="${NINFER_IMAGE:-ghcr.io/kobusg/ninfer-sm120a-quant-kv@sha256:c9285445c49e655d0363268e6bcc21cd52b1b4283e7fca2da6c864d4d350cb57}"
CUDA_MIN=13.1
ARCH=120a
DISK_GB="${NINFER_DISK:-80}"
APPS=/root/ninfer-5090/build-sm120a/apps
ARGV_FILE=/root/ninfer-argv-new.txt
SUPERVISE=/root/ninfer-supervise.sh
TARGET_GPU="${NINFER_GPU_NAME:-RTX PRO 4000}"
KV_DTYPE="${NINFER_KV_DTYPE:-rk4v4-e8}"
MAX_CONTEXT="${NINFER_MAX_CONTEXT:-145920}"
KV_CAPACITY="${NINFER_KV_CAPACITY:-145920}"
MAX_CONCURRENCY="${NINFER_MAX_CONCURRENCY:-2}"
PREFILL_CHUNK="${NINFER_PREFILL_CHUNK:-1024}"
SPEC_MODE="${NINFER_SPEC:-mtp}"
DRAFT_TOKENS="${NINFER_DRAFT_TOKENS:-3}"
VISION="${NINFER_VISION:-1}"
VISION_MAX_TOKENS="${NINFER_VISION_MAX_TOKENS:-8192}"

# Upstream accepts a closed set of artifacts and nothing else. These are the
# four supported artifacts, with the size and SHA-256 upstream publishes for
# each. Qwen3.8 groupwise-int is the default for this low-VRAM workflow.
case "${NINFER_MODEL:-qwen38-27b}" in
  nvfp4-27b)  HF_REPO=neroued/Qwen3.6-27B-nvfp4-NInfer; HF_FILE=qwen3_6_27b_nvfp4.ninfer
              MODEL_SHA=bce5f00d066c0f20f1317bf1fdcb458264cf95837c3b1f3fbec163694627893a; MODEL_GIB=17.07 ;;
  int-27b)    HF_REPO=neroued/Qwen3.6-27B-NInfer;       HF_FILE=qwen3_6_27b.ninfer
              MODEL_SHA=7b51600ffd10632b9660f56085efdd9b751d79733ad32036a652234b64bebe7b; MODEL_GIB=16.29 ;;
  qwen38-27b) HF_REPO=neroued/Qwen3.8-27B-NInfer;       HF_FILE=qwen3_8_27b.ninfer
              MODEL_SHA=eec39564993d6e9c7d5e383382a760f093465c9d163ec9a1bd6b80199514bf3e; MODEL_GIB=16.96 ;;
  moe-35b)    HF_REPO=neroued/Qwen3.6-35B-A3B-NInfer;   HF_FILE=qwen3_6_35b_a3b.ninfer
              MODEL_SHA=1fb9ea0b5b8561e49d9604115ec89e5d9f2b6f6434e32c37c57fffd480a325d2; MODEL_GIB=21.22 ;;
  *) printf 'error: unknown NINFER_MODEL "%s" — pick nvfp4-27b, int-27b, qwen38-27b or moe-35b\n' \
       "$NINFER_MODEL" >&2; exit 1 ;;
esac
MODEL_KEY="${NINFER_MODEL:-qwen38-27b}"
LABEL="ninfer-rtx6000pro-21gb-$MODEL_KEY"

# Optional tar kit fallback for images without bundled binaries.
B2_ENV="${NINFER_B2_ENV:-/Users/mike/coding/python_3/my_projects/awakedesk/.env}"
KIT_KEY="${NINFER_KIT_KEY:-}"
KIT_SHA1="${NINFER_KIT_SHA1:-}"
KIT_RELEASE_URL="${NINFER_KIT_URL:-}"

# Instance id: env override > saved state > none (create one).
INSTANCE="${NINFER_INSTANCE:-$( [ -f "$STATE" ] && cat "$STATE" || true )}"
API_BASE="https://console.vast.ai/api/v0"

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=no
          -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -i "$SSH_KEY")

bad_machines() { [ -f "$BADHOSTS" ] && cut -d' ' -f1 "$BADHOSTS" | paste -sd, - || true; }
info() { printf '  %s\n' "$*"; }
step() { printf '\n\033[1m%s\033[0m\n' "$*"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
need_instance() { [ -n "$INSTANCE" ] || die "no instance — run 'ninfer create'"; }

# Step banners. create() runs three of its own and then hands off to provision,
# which runs four more; standalone provision numbers them 1..4.
STEP_BASE=0; STEP_TOTAL=4; STEP_N=0
pstep() { STEP_N=$((STEP_N+1)); step "$((STEP_BASE+STEP_N))/$STEP_TOTAL  $*"; }
have_kit() { [ -n "$KIT_SHA1" ] && { [ -n "$KIT_RELEASE_URL" ] || [ -n "$KIT_KEY" ]; }; }

# --- vast api ---------------------------------------------------------------
api_get() { need_instance; curl -fsS -H "Authorization: Bearer $VAST_API_KEY" "$API_BASE/instances/${INSTANCE}/"; }

api_set_state() {
  need_instance
  curl -fsS -X PUT -H "Authorization: Bearer $VAST_API_KEY" -H "Content-Type: application/json" \
       -d "{\"state\":\"$1\"}" "$API_BASE/instances/${INSTANCE}/" >/dev/null
}

field() {
  api_get | INFO_KEY="$1" python3 -c '
import sys, json, os
d = json.load(sys.stdin)["instances"]
v = d.get(os.environ["INFO_KEY"])
print("" if v is None else v)'
}

endpoint() {
  api_get | python3 -c '
import sys, json
d = json.load(sys.stdin)["instances"]
ip = d.get("public_ipaddr")
p  = ((d.get("ports") or {}).get("8080/tcp") or [{}])[0].get("HostPort")
print("http://%s:%s/v1" % (ip.strip(), p) if ip and p else "")'
}

ssh_target() {
  api_get | python3 -c '
import sys, json
d = json.load(sys.stdin)["instances"]
print(d.get("ssh_host") or "", d.get("ssh_port") or "")'
}

box() {
  read -r h p < <(ssh_target)
  [ -n "$h" ] && [ -n "$p" ] || die "no ssh address yet"
  ssh "${SSH_OPTS[@]}" -p "$p" "root@$h" "$@"
}

wait_for() {
  local want="$1" limit="$2" waited=0 s msg
  while :; do
    # One call for both fields. Vast puts the real reason a box will not start
    # into status_msg — a broken CDI device map, a dead GPU — and it lands there
    # within a minute. Polling only actual_status means sitting out the whole
    # timeout and then reporting "still 'created'", which explains nothing.
    read -r s msg < <(api_get | python3 -c '
import sys, json
d = json.load(sys.stdin)["instances"]
print(d.get("actual_status") or "?", " ".join((d.get("status_msg") or "").split())[:300])' || echo "? ")
    [ "$s" = "$want" ] && { info "status: $s (${waited}s)"; return 0; }
    case "$msg" in *Error*)
      printf '\n'
      # Remember the machine. A host whose CDI device map cannot resolve its own
      # GPU will do it again, and the offer list will happily hand it back.
      local m; m=$(field machine_id 2>/dev/null || true)
      if [ -n "$m" ] && ! grep -q "^$m " "$BADHOSTS" 2>/dev/null; then
        printf '%s  %s  %s\n' "$m" "$(date -u +%F)" "$(printf '%s' "$msg" | cut -c1-90)" >> "$BADHOSTS"
        info "machine $m recorded in $(basename "$BADHOSTS") — pick_offer will skip it"
      fi
      die "vast could not start this box: $msg" ;;
    esac
    [ "$waited" -ge "$limit" ] && { printf '\n'; die "timed out after ${limit}s waiting for '$want' (still '$s')${msg:+ — vast says: $msg}"; }
    printf '\r  waiting… %s (%ds)   ' "${s:-?}" "$waited"; sleep 5; waited=$((waited+5))
  done
}

# A publickey rejection is indistinguishable from a box that has not finished
# booting, so this loop cannot tell you which one you are stuck on. If it runs
# the full 300s on a host that Vast reports healthy, suspect the key, destroy,
# and rent elsewhere rather than waiting longer.
wait_ssh() {
  local waited=0
  until box true 2>/dev/null; do
    [ "$waited" -ge 300 ] && die "ssh never came up (if the box looks healthy, the host never wrote authorized_keys — destroy and re-rent)"
    printf '\r  waiting for ssh… (%ds)   ' "$waited"; sleep 5; waited=$((waited+5))
  done
  info "ssh ready (${waited}s)"
}

# --- offers -----------------------------------------------------------------
# The reliability floor is 0.995, not the 0.97 you might reach for. Three hosts
# scoring above 0.97 failed in a row on the 3090 side — a dead GPU, a daemon
# that stopped reporting, and one that never wrote authorized_keys — and one of
# them scored 0.9959. Renting a healthy box first try is worth the extra cents.
OFFER_FILTER='
import sys, json, os
disk = float(os.environ.get("DISK", "80"))
bad = {t for t in os.environ.get("BAD", "").split(",") if t}
cuda = float(os.environ.get("CUDA_MIN", "13.1"))
gpu = os.environ.get("GPU", "RTX PRO 4000")
o = json.load(sys.stdin).get("offers", [])
ok = [x for x in o
      if x.get("gpu_name") == gpu
      and (x.get("disk_space") or 0) >= disk + 10
      and (x.get("inet_down") or 0) >= 1000
      and (x.get("reliability2") or 0) >= 0.99
      and (x.get("cuda_max_good") or 0) >= cuda
      and (x.get("gpu_ram") or 0) >= 23000
      and str(x.get("machine_id")) not in bad]
ok.sort(key=lambda x: x["dph_total"])
'

OFFER_Q=$(printf '{"gpu_name":{"eq":"%s"},"cuda_max_good":{"gte":%s},"num_gpus":{"eq":1},"rentable":{"eq":true},"order":[["dph_total","asc"]],"limit":500}' \
  "$TARGET_GPU" "$CUDA_MIN")

pick_offer() {  # echoes: id dph down loc
  curl -fsG -H "Authorization: Bearer $VAST_API_KEY" --data-urlencode "q=$OFFER_Q" "$API_BASE/bundles/" \
  | DISK="$DISK_GB" BAD="$(bad_machines)" CUDA_MIN="$CUDA_MIN" GPU="$TARGET_GPU" python3 -c "$OFFER_FILTER"'
if not ok: sys.exit("no offer matches (need %s, >=%dGB disk, >=1Gbps, CUDA %s+, reliability >=0.99)" % (gpu, disk, cuda))
x = ok[0]
print(x["id"], "%.4f" % x["dph_total"], "%.0f" % (x.get("inet_down") or 0), x.get("geolocation"))'
}

cmd_offers() {
  step "rentable $TARGET_GPU (>= ${DISK_GB}+10 GB disk, >= 1 Gbps, CUDA ${CUDA_MIN}+, reliability >= 0.99)"
  curl -fsG -H "Authorization: Bearer $VAST_API_KEY" --data-urlencode "q=$OFFER_Q" "$API_BASE/bundles/" \
  | DISK="$DISK_GB" BAD="$(bad_machines)" CUDA_MIN="$CUDA_MIN" GPU="$TARGET_GPU" python3 -c "$OFFER_FILTER"'
print("  %-9s %8s %11s %9s %6s  %s" % ("offer", "gpu/hr", "stor/GB/mo", "down", "rel", "location"))
for x in ok[:10]:
    print("  %-9s $%.4f  $%9.4f %6.0fMb %6.4f  %s" % (
        x["id"], x["dph_total"], x.get("storage_cost") or 0,
        x.get("inet_down") or 0, x.get("reliability2") or 0, x.get("geolocation")))
if not ok: print("  none right now — compatible CUDA 13.1+ low-VRAM boxes are a thin slice of the market")'
}

# --- opencode config --------------------------------------------------------
repoint() {
  local url="$1" mid="${2:-}" cfg
  for cfg in "${CONFIGS[@]}"; do
    [ -f "$cfg" ] || { info "skip (missing): $cfg"; continue; }
    PROVIDER="$PROVIDER" python3 - "$cfg" "$url" "$mid" "$MAX_CONTEXT" <<'PY'
import json, sys, os, collections
cfg, url, mid, max_context = sys.argv[1:5]
key = os.environ["PROVIDER"]
d = json.load(open(cfg), object_pairs_hook=collections.OrderedDict)
provs = d.setdefault("provider", collections.OrderedDict())
fresh = key not in provs
prov = provs.setdefault(key, collections.OrderedDict())

prov["npm"] = "@ai-sdk/openai-compatible"
prov.setdefault("name", "NInfer RTX6000 Pro 21GB")
opts = prov.setdefault("options", collections.OrderedDict())
old = opts.get("baseURL")
opts["baseURL"] = url
opts.setdefault("apiKey", "{env:NINFER_API_KEY}")

# One engine holds one resident artifact, so any other model id listed here is
# left over from a run with a different NINFER_MODEL and would only ever 400.
models = prov.setdefault("models", collections.OrderedDict())
if mid and list(models) != [mid]:
    models.clear()
    models[mid] = collections.OrderedDict([
        ("name", "%s [NInfer RTX6000 Pro 21GB]" % mid),
        ("model", mid),
        ("limit", collections.OrderedDict([("context", int(max_context)), ("output", 8192)])),
    ])

json.dump(d, open(cfg, "w"), indent=2); open(cfg, "a").write("\n")
if fresh:
    print("  created:   %s" % cfg)
    print("             provider %r -> %s" % (key, url))
elif old != url:
    print("  updated:   %s" % cfg)
    print("             %s -> %s" % (old, url))
else:
    print("  unchanged: %s" % cfg)
if mid:
    print("             model %s/%s" % (key, mid))
else:
    print("             server named no model - set one by hand")
PY
  done
  python3 - "$url" "$ENV_FILE" <<'PY'
import re, sys
s = open(sys.argv[2]).read()
new = "NINFER_BASE_URL=" + sys.argv[1]
s = re.sub(r'^NINFER_BASE_URL=.*$', new, s, flags=re.M) if re.search(
    r'^NINFER_BASE_URL=', s, flags=re.M) else s.rstrip("\n") + "\n" + new + "\n"
open(sys.argv[2], "w").write(s)
PY
  info "updated:   $ENV_FILE"
}

health() { curl -s -m 15 -o /dev/null -w '%{http_code}' \
           -H "Authorization: Bearer $NINFER_API_KEY" "$1/models" || echo 000; }

# Upstream advertises the loaded container's own identity.model_id unless
# --model-id overrides it, and the four artifacts do not share one. Read it off
# the server instead of guessing, so the config can never disagree with what is
# actually resident.
served_model() {
  curl -fsS -m 15 -H "Authorization: Bearer $NINFER_API_KEY" "$1/models" 2>/dev/null \
  | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    print(""); raise SystemExit
ids = [m.get("id") for m in (d.get("data") or []) if m.get("id")]
print(ids[0] if ids else "")' || true
}

# --- kit --------------------------------------------------------------------
kit_url() {
  have_kit || die "no kit published yet — 'ninfer build' then 'ninfer kit-pack'"
  # Public path: whatever release URL has been filled in above. Used whenever B2
  # credentials are absent, which is the normal case for anyone who did not
  # build the kit themselves.
  if [ ! -f "$B2_ENV" ] || [ -z "$KIT_KEY" ]; then
    [ -n "$KIT_RELEASE_URL" ] || die "no public kit URL configured"
    printf '%s\n' "$KIT_RELEASE_URL"
    return 0
  fi
  ( set -a; . "$B2_ENV"; set +a
    : "${B2_KEY_ID:?}" "${B2_APPLICATION_KEY:?}" "${B2_BUCKET_NAME:?}"
    auth=$(curl -fsS -u "$B2_KEY_ID:$B2_APPLICATION_KEY" \
           https://api.backblazeb2.com/b2api/v3/b2_authorize_account) || exit 1
    read -r api dl bid tok <<<"$(printf '%s' "$auth" | python3 -c '
import sys, json
d = json.load(sys.stdin); s = d["apiInfo"]["storageApi"]
print(s["apiUrl"], s["downloadUrl"], s["bucketId"], d["authorizationToken"])')"
    dtok=$(curl -fsS -H "Authorization: $tok" -H "Content-Type: application/json" \
           -d "{\"bucketId\":\"$bid\",\"fileNamePrefix\":\"${KIT_KEY%%/*}/\",\"validDurationInSeconds\":7200}" \
           "$api/b2api/v3/b2_get_download_authorization" \
           | python3 -c 'import sys,json;print(json.load(sys.stdin)["authorizationToken"])')
    printf '%s/file/%s/%s?Authorization=%s\n' "$dl" "$B2_BUCKET_NAME" "$KIT_KEY" "$dtok" )
}

install_kit() {  # download and unpack a published kit; run on the box
  have_kit || die "no kit published yet — 'ninfer build' compiles from source instead"
  { printf 'KIT_URL=%q\nKIT_SHA1=%q\nAPPS=%q\n' "$(kit_url)" "$KIT_SHA1" "$APPS"; cat <<'EOS'
set -e
curl -fsSL -o /root/kit.tar.gz "$KIT_URL"
got=$(sha1sum /root/kit.tar.gz | cut -d' ' -f1)
[ "$got" = "$KIT_SHA1" ] || { echo "sha1 mismatch: $got"; exit 1; }
tar xzf /root/kit.tar.gz -C /root && rm -f /root/kit.tar.gz
mkdir -p "$APPS"
# install via rename — cp over a running binary fails with ETXTBSY
for b in ninfer ninfer-serve; do
  cp "/root/kit/bin/$b" "$APPS/$b.new"; chmod +x "$APPS/$b.new"; mv -f "$APPS/$b.new" "$APPS/$b"
done
echo "kit installed:"; ls -la "$APPS" | tail -2
EOS
  } | box 'bash -s'
}

cmd_build() {
  die "GPU-instance builds are disabled; build and publish the runtime image locally"
}

cmd_kit_pack() {  # tar the built binaries and bring the tarball back here
  need_instance
  box 'test -x /root/kit/bin/ninfer-serve' 2>/dev/null || die "nothing built on this box — run 'ninfer build' first"
  local rev short name out
  rev=$(box "sed -n 's/^revision *//p' /root/kit/BUILDINFO.txt")
  short="${rev:0:12}"
    name="ninfer-rtx6000pro-21gb-kit-${short}-sm${ARCH}.tar.gz"
  out="$PROJ/dist/$name"
  mkdir -p "$PROJ/dist"

  step "packing $name"
  box "cd /root && tar czf /root/$name kit && ls -l /root/$name" | sed 's/^/  /'
  read -r h p < <(ssh_target)
  scp "${SSH_OPTS[@]}" -P "$p" "root@$h:/root/$name" "$out"
  box "rm -f /root/$name"

  step "kit is here"
  info "file:  $out"
  info "bytes: $(wc -c < "$out" | tr -d ' ')"
  info "sha1:  $(shasum -a 1 "$out" | cut -d' ' -f1)"
  info "sha256:$(shasum -a 256 "$out" | cut -d' ' -f1)"
  info ""
  info "publish it, then set KIT_SHA1 and KIT_RELEASE_URL near the top of this"
  info "script so 'create' downloads instead of compiling."
}

# --- serving ----------------------------------------------------------------
# The argv lives here rather than inside the kit so that changing a serving flag
# does not mean rebuilding and republishing a 400 MB tarball.
write_argv() {
  {
    printf '%s\n' "$APPS/ninfer-serve" "/root/models/$HF_FILE"
    printf '%s\n' --host 0.0.0.0 --port 8080 --api-key "$NINFER_API_KEY"
    printf '%s\n' --max-context "$MAX_CONTEXT" --kv-capacity "$KV_CAPACITY" --kv-dtype "$KV_DTYPE"
    printf '%s\n' --max-concurrency "$MAX_CONCURRENCY" --prefill-chunk "$PREFILL_CHUNK" --no-thinking
    if [ "$VISION" = 1 ]; then
      printf '%s\n' --vision --vision-max-tokens "$VISION_MAX_TOKENS"
    fi
    if [ "$SPEC_MODE" != none ]; then
      printf '%s\n' --spec "$SPEC_MODE" --draft-tokens "$DRAFT_TOKENS" --lm-head-draft
    fi
  } | box "tee $ARGV_FILE >/dev/null"
  box "chmod 600 $ARGV_FILE"
}

ensure_serving() {  # write supervise, launch if dead, wait for HTTP 200, repoint
  step "starting ninfer-serve"
  write_argv
  box "cat > $SUPERVISE" <<PY
#!/usr/bin/env bash
# Keeps ninfer-serve alive using the argv written by the CLI.
mapfile -t A < $ARGV_FILE
while true; do
  echo "=== starting \$(date -u) ===" >> /root/serve.log
  "\${A[@]}" >> /root/serve.log 2>&1
  echo "=== exited rc=\$? at \$(date -u); restart in 5s ===" >> /root/serve.log
  sleep 5
done
PY
  box "chmod +x $SUPERVISE"
  if box 'pgrep -f "[n]infer-serve" >/dev/null'; then
    info "already serving"
  else
    box "setsid nohup $SUPERVISE < /dev/null > /dev/null 2>&1 &" || true
    info "launched supervise loop"
  fi

  step "waiting for the model to load"
  local url waited=0
  url=$(endpoint); [ -n "$url" ] || die "no endpoint yet"
  until [ "$(health "$url")" = 200 ]; do
    [ "$waited" -ge 420 ] && die "server never answered on $url (check: ninfer log)"
    printf '\r  loading… (%ds)   ' "$waited"; sleep 5; waited=$((waited+5))
  done
  info "serving (${waited}s)"

  step "re-pointing OpenCode"
  local mid; mid=$(served_model "$url")
  repoint "$url" "$mid"
  step "ready — $url"
  info "model:    $HF_FILE (${MODEL_GIB} GiB, $MODEL_KEY)"
  [ -n "$mid" ] && info "opencode: pick $PROVIDER/$mid"
  info "costing \$$(printf '%.4f' "$(field dph_total)")/hr; 'ninfer destroy' when you're done"
}

# --- commands ---------------------------------------------------------------
# --- benchmark ---------------------------------------------------------------
# Runs on the box over localhost, so no network is in the number, and reports
# the ENGINE'S figures rather than the client's. Counting SSE deltas undercounts
# badly: MTP commits two to four tokens per round, and ninfer-serve already logs
# per-request decode rate, speculative acceptance and aggregate batch throughput.
cmd_bench() {
  need_instance
  local url mid; url=$(endpoint); mid=$(served_model "$url")
  [ -n "$mid" ] || die "server is not answering — try 'ninfer status'"
  local list="${1:-1,2,4,8}" maxnew="${NINFER_BENCH_TOKENS:-600}"
  step "benchmark — $mid, concurrency $list, $maxnew tokens per stream"
  info "measured on the box over localhost; figures are ninfer-serve's own"
  box "APIKEY=$(printf %q "$NINFER_API_KEY") MODEL=$(printf %q "$mid") LIST=$(printf %q "$list") MAXNEW=$(printf %q "$maxnew") python3 -" <<'PY'
import datetime, json, os, re, threading, time, urllib.request

KEY, MODEL = os.environ["APIKEY"], os.environ["MODEL"]
MAXNEW = int(os.environ["MAXNEW"])
LOG = "/root/serve.log"
PROMPT = ("Write a detailed technical explanation of how paged KV caches work in a "
          "transformer inference engine, covering block allocation, prefix reuse, "
          "eviction and fragmentation. Be thorough and specific.")

def fire(i):
    body = json.dumps({"model": MODEL, "max_tokens": MAXNEW, "messages":
        [{"role": "user", "content": "%s (variant %d)" % (PROMPT, i)}]}).encode()
    req = urllib.request.Request("http://127.0.0.1:8080/v1/chat/completions", body,
        {"Authorization": "Bearer " + KEY, "Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=900).read()
    except Exception as e:
        print("    request %d failed: %s" % (i, e))

print("    %-3s %12s %12s %12s %9s" % ("C", "per-stream", "aggregate", "MTP", "accept"))
print("    %-3s %12s %12s %12s %9s" % ("", "tok/s", "tok/s", "tok/round", ""))
for C in [int(x) for x in os.environ["LIST"].split(",")]:
    at = os.path.getsize(LOG)
    ths = [threading.Thread(target=fire, args=(i,)) for i in range(C)]
    for t in ths: t.start()
    for t in ths: t.join()
    time.sleep(3)                      # let the last 'done' line land
    with open(LOG, "rb") as f:
        f.seek(at); new = f.read().decode("utf-8", "replace")
    dec  = [float(x) for x in re.findall(r"\] done .*? decode=([0-9.]+)tok/s", new)]
    spec = re.findall(r"speculative=mtp ([0-9.]+)tok/round \(([0-9.]+)%\)", new)
    # Aggregate from the requests themselves, not the engine's 5s interval
    # report. That window averages in whatever idle time it happens to span, so
    # at C=1 it reads well under what the GPU was doing while it was doing it,
    # and at C=8 it swings by a third depending on where the burst lands.
    done = re.findall(r"^\[([0-9-]+ [0-9:.]+)\].*?\] done .*? gen=([0-9]+) .*? wall=([0-9.]+)s",
                      new, re.M)
    if not dec:
        print("    %-3d  no completed requests appeared in the log" % C)
        continue
    agg = None
    if len(done) >= C:
        rows = []
        for ts, gen, wall in done[-C:]:
            end = datetime.datetime.strptime(ts, "%Y-%m-%d %H:%M:%S.%f")
            rows.append((end - datetime.timedelta(seconds=float(wall)), end, int(gen)))
        span = (max(r[1] for r in rows) - min(r[0] for r in rows)).total_seconds()
        if span > 0:
            agg = sum(r[2] for r in rows) / span
    print("    %-3d %12.1f %12s %12.2f %9.1f%%" % (
        C, sum(dec)/len(dec), "%.1f" % agg if agg else "—",
        sum(float(a) for a, _ in spec)/len(spec) if spec else 0,
        sum(float(b) for _, b in spec)/len(spec) if spec else 0))
print()
print("    per-stream is each request's own decode rate, as ninfer-serve reports it.")
print("    aggregate is total tokens over the wall time the burst actually occupied.")
PY
}

cmd_status() {
  [ -n "$INSTANCE" ] || { step "no instance"; info "run 'ninfer create' to rent one"; return; }
  local s url code
  s=$(field actual_status)
  step "instance $INSTANCE — $(field gpu_name) — $s"
  info "label:   $(field label)"
  info "model:   $HF_FILE (${MODEL_GIB} GiB)"
  info "runtime: $IMAGE"
  info "rate:    \$$(printf '%.4f' "$(field dph_total)")/hr running"
  info "         \$$(printf '%.4f' "$(field storage_total_cost)")/hr stopped (disk only)"
  info "disk:    $(field disk_usage) GB used of $(field disk_space) GB"
  if [ "$s" = "running" ]; then
    url=$(endpoint); info "api:     $url"
    read -r h p < <(ssh_target); info "ssh:     root@$h -p $p"
    code=$(health "$url")
    info "health:  HTTP $code$([ "$code" = 200 ] && echo '  (serving)' || echo '  (not answering yet)')"
  fi
}

cmd_create() {
  [ -n "$INSTANCE" ] && [ "$(field actual_status 2>/dev/null || true)" != "" ] && \
    die "instance $INSTANCE already exists — 'ninfer up' to resume it, or 'ninfer destroy' first"

  step "1/3  picking a $TARGET_GPU"
  local offer dph down loc
  if [ -n "${1:-}" ]; then
    offer="$1"; dph="?"; down="?"; loc="(chosen by hand — see 'ninfer offers')"
  else
    read -r offer dph down loc <<<"$(pick_offer)"
  fi
  info "offer $offer — \$$dph/hr — ${down} Mbps down — $loc"

  step "2/3  renting it"
  local resp new
  # No -f here. Vast explains a refusal in the response body, and -f throws the
  # body away, so a rejected offer used to surface as a bare "curl: (56) ... 400".
  local code
  resp=$(curl -sS -w '\n%{http_code}' -X PUT -H "Authorization: Bearer $VAST_API_KEY" -H "Content-Type: application/json" \
    -d "{\"client_id\":\"me\",\"image\":\"$IMAGE\",\"disk\":$DISK_GB,\"label\":\"$LABEL\",\"runtype\":\"ssh\",\"onstart\":\"\",\"env\":{\"-p 8080:8080\":\"1\"}}" \
    "$API_BASE/asks/${offer}/")
  code="${resp##*$'\n'}"; resp="${resp%$'\n'*}"
  [ "$code" = 200 ] || die "vast refused offer $offer (HTTP $code): $(printf '%s' "$resp" | head -c 400)"
  new=$(printf '%s' "$resp" | python3 -c '
import sys, json
d = json.load(sys.stdin)
if not d.get("success"): sys.exit("vast refused: %s" % d)
print(d["new_contract"])')
  [ -n "$new" ] || die "no contract id returned"
  INSTANCE="$new"; printf '%s\n' "$new" > "$STATE"
  info "instance $INSTANCE (saved to $STATE)"
  wait_for running 900

  step "3/3  waiting for ssh"
  wait_ssh

  STEP_BASE=3 STEP_TOTAL=7 cmd_provision
}

# Everything after the box exists. Split out of create so a run that dies late
# -- a timeout, a dropped ssh -- can be finished on the box already paid for
# instead of destroying it and renting another.
cmd_provision() {
  need_instance
  # Cheap when create just did this a second ago, and it is what makes the
  # command safe to run on its own against a box that is still coming up.
  [ "$(field actual_status)" = running ] || wait_for running 900
  box true 2>/dev/null || wait_ssh
  pstep "provisioning (deps + ${MODEL_GIB} GiB model, detached — this is the long part)"
  { printf 'HF_REPO=%q\nHF_FILE=%q\nMODEL_SHA=%q\n' "$HF_REPO" "$HF_FILE" "$MODEL_SHA"; cat <<'EOS'
cat > /root/provision-ninfer.sh <<INNER
#!/usr/bin/env bash
set -e
HF_REPO="$HF_REPO"; HF_FILE="$HF_FILE"; MODEL_SHA="$MODEL_SHA"
INNER
cat >> /root/provision-ninfer.sh <<'INNER'
export DEBIAN_FRONTEND=noninteractive
touch /root/deps.done
echo "[$(date -u +%T)] DEPS_DONE"
echo "[$(date -u +%T)] hf client"
python3 -m venv /root/hfenv
/root/hfenv/bin/pip -q install --upgrade pip "huggingface_hub[hf_transfer]"
echo "[$(date -u +%T)] model download ($HF_FILE)"
export HF_HUB_ENABLE_HF_TRANSFER=1
mkdir -p /root/models
/root/hfenv/bin/hf download "$HF_REPO" "$HF_FILE" --local-dir /root/models
echo "[$(date -u +%T)] verifying sha256"
got=$(sha256sum "/root/models/$HF_FILE" | cut -d' ' -f1)
[ "$got" = "$MODEL_SHA" ] || { echo "MODEL SHA MISMATCH: $got"; exit 1; }
echo "[$(date -u +%T)] PROVISION_DONE"
ls -la /root/models/
INNER
chmod +x /root/provision-ninfer.sh
setsid nohup /root/provision-ninfer.sh > /root/provision.log 2>&1 < /dev/null &
echo "provisioning started"
EOS
  } | box 'bash -s'

  if box "test -x $APPS/ninfer-serve" 2>/dev/null; then
    pstep "using binaries bundled in the runtime image"
  elif have_kit; then
    pstep "installing the prebuilt binaries"
    install_kit
  else
    die "runtime image has no ninfer-serve binary and no fallback kit is configured"
  fi

  pstep "waiting on the model download"
  local waited=0
  until box 'grep -q PROVISION_DONE /root/provision.log' 2>/dev/null; do
    box 'grep -q "SHA MISMATCH" /root/provision.log' 2>/dev/null && die "model failed its checksum — ninfer ssh, then: tail /root/provision.log"
    [ "$waited" -ge 1800 ] && die "provisioning stalled — ninfer ssh, then: tail /root/provision.log"
    printf '\r  %s (%ds)   ' "$(box 'tail -1 /root/provision.log 2>/dev/null | cut -c1-60' 2>/dev/null || echo '…')" "$waited"
    sleep 15; waited=$((waited+15))
  done
  info "provisioned (${waited}s)"

  pstep "bringing up the server"
  ensure_serving
}

cmd_destroy() {
  need_instance
  local s; s=$(field actual_status 2>/dev/null || echo unknown)
  step "destroying instance $INSTANCE (currently $s)"
  info "this deletes the disk — the ${MODEL_GIB} GiB model will be re-downloaded next time"
  curl -fsS -X DELETE -H "Authorization: Bearer $VAST_API_KEY" "$API_BASE/instances/${INSTANCE}/" >/dev/null
  # only forget the saved id if that is the one we just deleted — a
  # NINFER_INSTANCE override must not clear the tracked instance
  [ -f "$STATE" ] && [ "$(cat "$STATE")" = "$INSTANCE" ] && rm -f "$STATE"
  step "destroyed — idle cost is now \$0.00/hr"
}

cmd_up() {
  need_instance
  local s; s=$(field actual_status)
  step "1/3  starting instance $INSTANCE"
  if [ "$s" = "running" ]; then info "already running"; else api_set_state running; wait_for running 300; fi
  step "2/3  waiting for ssh"
  wait_ssh
  step "3/3  server"
  ensure_serving
}

cmd_down() {
  need_instance
  local s; s=$(field actual_status)
  if [ "$s" != "running" ]; then step "already $s"; cmd_status; return; fi
  step "stopping instance $INSTANCE"
  api_set_state stopped
  wait_for exited 300
  step "down"
  info "disk kept: $(field disk_usage) GB of $(field disk_space) GB"
  info "STILL BILLING \$$(printf '%.4f' "$(field storage_total_cost)")/hr for storage"
  info "use 'ninfer destroy' instead to pay nothing at all"
}

case "${1:-status}" in
  create)    shift; cmd_create "${1:-}" ;;
  provision) cmd_provision ;;
  bench)     shift; cmd_bench "${1:-}" ;;
  destroy|rm) cmd_destroy ;;
  up)        cmd_up ;;
  down|stop) cmd_down ;;
  status)    cmd_status ;;
  offers)    cmd_offers ;;
  build)     cmd_build ;;
  kit-pack)  cmd_kit_pack ;;
  kit-url)   kit_url ;;
  restore)   install_kit ;;
  ssh)       shift; read -r h p < <(ssh_target); exec ssh "${SSH_OPTS[@]}" -p "$p" "root@$h" "$@" ;;
  log)       box 'tail -n 40 -f /root/serve.log' ;;
  *)         sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
