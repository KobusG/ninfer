#!/usr/bin/env python3
"""Print the selected Vast offer ID for an NInfer hardware profile."""

import argparse

from ninferlib import PROFILE_ALIASES, ContextManager, context_args, pick_offer


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("profile", choices=PROFILE_ALIASES, help="Hardware/profile preset")
    parser.add_argument("--gpu", dest="gpu_name")
    parser.add_argument("--disk", type=int)
    parser.add_argument("--rank", type=int)
    parser.add_argument("--community", dest="secure_cloud", action="store_false", default=None)
    parser.add_argument("--vast-api-key")
    args = parser.parse_args()

    ctx = ContextManager(args.profile, context_args(**vars(args)))
    ctx.require_vast_key()
    print(pick_offer(ctx)["id"])


if __name__ == "__main__":
    main()
