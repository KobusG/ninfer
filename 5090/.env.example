# Vast.ai API key — https://cloud.vast.ai/account/
VAST_API_KEY=

# Bearer token the served API will require. Invent one; it is not issued by anybody.
NINFER_API_KEY=

# Written automatically by 'ninfer create' / 'ninfer up'. Leave blank.
NINFER_BASE_URL=

# Qwen3.8 NVFP4 is the RTX 5090 default. Use qwen38-27b for lower VRAM use.
NINFER_MODEL=qwen38-nvfp4
