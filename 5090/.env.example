# Required Vast credential. Never commit this file after filling it in.
VAST_API_KEY=

# Required bearer token for the served API. Invent a strong value.
NINFER_API_KEY=

# Optional Compose-only API key. Leave blank when authenticated Caddy is the
# sole boundary; validate-vast generates a separate temporary key automatically.
CHAT_API_KEY=

# Optional for gated Hugging Face artifacts. It is passed only to the runtime.
HF_TOKEN=

# Written automatically by 'ninfer create' / 'ninfer up'. Leave blank.
NINFER_BASE_URL=

# Rental profile. Defaults require a verified Secure Cloud RTX 5090 with two
# direct mapped ports. Rank 2 avoids repeatedly selecting the cheapest host.
NINFER_GPU_NAME="RTX 5090"
NINFER_SECURE_CLOUD=1
NINFER_OFFER_RANK=2
NINFER_DISK=80

# Immutable model-free ENTRYPOINT image. Use only a validated manifest digest.
# 'ninfer build' refuses GPU builds; replacement images must be built locally.
NINFER_IMAGE=ghcr.io/kobusg/ninfer-sm120a-quant-kv@sha256:e7f5dbdd202bef2ac8fa48bef28584cae3a6fc6b5f513fef0e49bd280a2e1ae3

# RTX 5090 default artifact. The entrypoint downloads it at runtime and rejects
# any file whose SHA-256 differs from bb3360522a06e136e0367f5703414d26272b7285c8a6ab6194135c17dbd81b32.
# Alternatives include qwen38-quasar and qwen38-nvfp4full.
NINFER_MODEL=qwen38-nvfp4

# Headroom-oriented RTX 5090 profile. Context and KV capacity must match, be
# multiples of 64, and not exceed the image's 1048576-token envelope. The
# measured startup boundary was 551232; 551296 failed its runtime reservation.
# 524288 trades about 27K boundary tokens for roughly 475 MiB more reservation
# margin. From the repository root, run ./validate-vast --compose 5090/compose.yaml
# OFFER_ID and ./benchmark-api before production.
NINFER_KV_DTYPE=rk4v4-e8
NINFER_MAX_CONTEXT=524288
NINFER_KV_CAPACITY=524288
NINFER_MAX_CONCURRENCY=2
NINFER_PREFILL_CHUNK=1024
NINFER_SPEC=mtp
NINFER_DRAFT_TOKENS=3
NINFER_VISION=1
NINFER_VISION_MAX_TOKENS=8192
NINFER_CHAT_TEMPLATE=/usr/share/doc/ninfer/froggeric-chat-template.jinja
NINFER_REASONING_EFFORT=medium

# Local orchestration overrides. INSTANCE targets an existing contract; leave
# it blank for normal state-file operation. BENCH_TOKENS controls each stream.
NINFER_PROVIDER=ninfer5090
NINFER_SSH_KEY=~/.ssh/kobus
NINFER_INSTANCE=
NINFER_BENCH_TOKENS=600

# Advanced path overrides, normally omitted. ENV_FILE must contain credentials.
# NINFER_PROJ=/absolute/path/to/5090
# NINFER_ENV_FILE=/absolute/path/to/5090/.env

# Local replacement-image build overrides. SOURCE_REF must be a full commit.
# NINFER_SOURCE_REPO=https://github.com/KobusG/ninfer-engine.git
# NINFER_SOURCE_REF=27b24bae4d63633a0f8681ef9b5cc253fd964bf1
# NINFER_IMAGE_REPOSITORY=ghcr.io/kobusg/ninfer-sm120a-quant-kv
